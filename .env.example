# --- Server ---
PORT=3001
# Where the SQLite database lives (created on first run)
POCKETPILOT_DB=./data/pocketpilot.db

# --- Online price search (all optional; providers are tried in this order) ---
# SerpApi Google Shopping (best structured prices): https://serpapi.com
SERPAPI_KEY=
# Brave Search API (web results, prices parsed from snippets): https://brave.com/search/api
BRAVE_SEARCH_API_KEY=
# DuckDuckGo HTML fallback needs no key but can be rate-limited. Set to "0" to disable.
ENABLE_DDG_SEARCH=1
# Cache successful lookups for this many hours before searching again.
PRICE_CACHE_HOURS=24
# Country/currency hint appended to shopping searches.
PRICE_SEARCH_COUNTRY=us

# --- Exchange rates (for kids who don't use US dollars) ---
# Live rates come from frankfurter.app (free, no key). Set to "0" to use the built-in approximate table only.
ENABLE_LIVE_FX=1
FX_CACHE_HOURS=24
